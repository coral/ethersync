{
  "name": "ethersync-web",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "pnpm wasm && vite --host 127.0.0.1",
    "build": "pnpm wasm && tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "pnpm wasm && node --test tests/*.test.mjs",
    "measure": "pnpm wasm && node scripts/measure-accuracy.mjs",
    "replay": "pnpm wasm && node scripts/replay-trace.mjs",
    "analyze": "node scripts/analyze-trace.mjs"
  },
  "dependencies": {
    "@moq/net": "0.3.5"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
